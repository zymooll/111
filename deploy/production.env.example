POSTGRES_DB=campus_foodie
POSTGRES_USER=campus_foodie
POSTGRES_PASSWORD=replace-with-a-random-database-password

# 至少 32 位随机串，且不能沿用任何示例值，否则 API 会拒绝启动。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# 生产不播种演示数据。首个管理员用下面的命令创建（密码留空则随机生成并打印一次）：
#   docker compose -f compose.production.yml exec api python -m app create-admin \
#     --username admin --email admin@example.com --super-admin
AUTO_SEED=false

# 对外域名。Caddy 会为这三个域名自动申请证书，容器自身不发布端口。
USER_WEB_DOMAIN=foodie.example.com
ADMIN_WEB_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
# 管理端来源限制，建议收敛到办公网出口，例如 203.0.113.0/24
ADMIN_ALLOWED_CIDR=0.0.0.0/0

PUBLIC_API_BASE_URL=https://api.example.com/api/v1
PUBLIC_ADMIN_API_BASE_URL=https://api.example.com/admin/api/v1
CORS_ORIGINS=https://foodie.example.com,https://admin.example.com
USER_WEB_ORIGIN=https://foodie.example.com

# 未配置 SMTP 时邮箱验证与找回密码会静默失效，因此生产必填。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=Campus Foodie <no-reply@example.com>

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=8

AMAP_KEY=
# 高德 securityJsCode 不应下发到浏览器，请由服务端代理承载后再启用。
